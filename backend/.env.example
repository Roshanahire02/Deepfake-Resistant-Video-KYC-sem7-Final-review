# ---------------- Database ----------------
# Default: SQLite (zero setup, what this project is developed and tested on).
DATABASE_URL=sqlite:///./storage/dev.db
# PostgreSQL is optional and has NOT been run end-to-end in this project:
# DATABASE_URL=postgresql://kyc_user:kyc_password@localhost:5432/deepfake_kyc

# ---------------- Auth ----------------
# Generate a real secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------- Storage ----------------
UPLOAD_DIR=./storage/uploads
TEMP_VIDEO_DIR=./storage/temp_video
MODEL_DIR=./storage/models
MAX_UPLOAD_MB=10

# ---------------- Risk thresholds (configurable) ----------------
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=70
FACE_MATCH_THRESHOLD=0.55

# ---------------- Brute-force protection (per client IP) ----------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_MIN=5

# ---------------- CORS ----------------
FRONTEND_ORIGIN=http://localhost:5173
